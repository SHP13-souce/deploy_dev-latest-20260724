<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget parent="main_window" name="Main Window">
  <Tab tab_name="Tracking" containers="1">
   <Container>
    <DockSplitter sizes="0.34;0.33;0.33" count="3" orientation="-">
     <DockArea name="Tracker state and NIS">
      <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
       <range left="0" right="10" bottom="0" top="15"/>
       <limitY/>
       <curve color="#1f77b4" name="/tracker/state_code"/>
       <curve color="#d62728" name="/tracker/nis"/>
       <curve color="#ff7f0e" name="/tracker/nis_failure_ratio"/>
      </plot>
     </DockArea>
     <DockArea name="Target motion">
      <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
       <range left="0" right="10" bottom="-5" top="5"/>
       <limitY/>
       <curve color="#1f77b4" name="/state/x"/>
       <curve color="#2ca02c" name="/state/y"/>
       <curve color="#9467bd" name="/state/z"/>
       <curve color="#d62728" name="/state/yaw_rate"/>
      </plot>
     </DockArea>
     <DockArea name="Aim">
      <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
       <range left="0" right="10" bottom="-1" top="1"/>
       <limitY/>
       <curve color="#1f77b4" name="/aim/yaw_rad"/>
       <curve color="#d62728" name="/aim/pitch_rad"/>
       <curve color="#2ca02c" name="/aim/fly_time_s"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Pipeline" containers="1">
   <Container>
    <DockSplitter sizes="0.5;0.5" count="2" orientation="-">
     <DockArea name="Detection and PnP">
      <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
       <range left="0" right="10" bottom="0" top="10"/>
       <limitY/>
       <curve color="#1f77b4" name="/detection/count"/>
       <curve color="#2ca02c" name="/pnp/valid_count"/>
       <curve color="#d62728" name="/pnp/reprojection_mean_px"/>
       <curve color="#ff7f0e" name="/pnp/reprojection_max_px"/>
      </plot>
     </DockArea>
     <DockArea name="Stage latency (ms)">
      <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
       <range left="0" right="10" bottom="0" top="30"/>
       <limitY/>
       <curve color="#1f77b4" name="/latency_ms/detection"/>
       <curve color="#ff7f0e" name="/latency_ms/pnp"/>
       <curve color="#2ca02c" name="/latency_ms/tracker"/>
       <curve color="#9467bd" name="/latency_ms/aim"/>
       <curve color="#d62728" name="/latency_ms/total"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <Plugins>
  <plugin ID="UDP Server"/>
 </Plugins>
 <previouslyLoaded_Datafiles/>
 <previouslyLoaded_Streamer name="UDP Server"/>
 <customMathEquations/>
 <snippets/>
</root>
