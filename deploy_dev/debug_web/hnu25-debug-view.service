[Unit]
Description=HNU25 safe vision Web debug view
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=robomaster
Group=robomaster
WorkingDirectory=/home/robomaster/hnu25-deploy-current
Environment=DEBUG_WEB_HOST=0.0.0.0
Environment=DEBUG_WEB_PORT=5000
Environment=DEBUG_WEB_SHM=/hnu_vision_debug
ExecStart=/usr/bin/bash /home/robomaster/hnu25-deploy-current/debug_web/debug.sh /home/robomaster/hnu25-deploy-current/build-release/pipeline/sp_standard /home/robomaster/hnu25-deploy-current/config/nuc144_safe.yaml
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
